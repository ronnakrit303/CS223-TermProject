# =============================================================================
# CS223-TermProject | Kolla Ansible Multinode Inventory Example
# =============================================================================
# Project       : CS223 OpenStack Installation & Deployment
# File          : config/multinode.example
# Stack         : OpenStack 2026.1 / Kolla Ansible 22.x (stable/2026.1)
# OS            : Ubuntu Server 24.04 LTS
# Environment   : Non-HA academic lab, 1 controller + 1 compute
# Reference     : https://github.com/openstack/kolla-ansible/blob/stable/2026.1/ansible/inventory/multinode
#
# ข้อควรทราบก่อนใช้งาน
# ---------------------
# 1. ไฟล์นี้เป็นตัวอย่างสำหรับเผยแพร่บน PUBLIC GitHub ไม่ใช่สำเนา ~/multinode
#    ที่ใช้งานจริง ข้อมูล Node/IP อ้างอิงจาก Lab แต่ค่า SSH อาจต่างจากไฟล์จริง
# 2. ระบบปัจจุบัน Deploy สำเร็จแล้ว อย่าแทนที่ ~/multinode หรือ Deploy ซ้ำ
#    โดยไม่จำเป็น
# 3. ห้าม Commit SSH Private Key, Password, admin-openrc.sh, clouds.yaml,
#    passwords.yml รวมถึง Log/Console Token ที่ยังไม่ได้ปกปิดข้อมูลลับ
# 4. Inventory ใช้รูปแบบ Ansible INI (ไม่ใช่ YAML) และต้องรักษาชื่อ Groups
# 5. การอยู่ใน Service Group หมายถึงตำแหน่งติดตั้ง ไม่ได้หมายความว่าเปิดบริการ
#    การ Enable/Disable ใช้ /etc/kolla/globals.yml และค่า Default ของ Kolla
# 6. เก็บโครงสร้าง Service Groups จาก upstream stable/2026.1 อย่างครบถ้วน
#    ถ้า Upgrade Release ให้ตรวจเทียบกับ Inventory ต้นฉบับของเวอร์ชันใหม่
#
# โครงสร้าง LAB จริง (OpenStack ชั้นใน)
# ---------------------------------
# Controller / deployment host: controller01 -> 192.168.1.160 (ens3)
# Compute node                : compute01    -> 192.168.1.7   (ens3)
# API + tunnel interface      : ens3
# Example external interface : dummy0 on controller01 (lab only)
# Underlay MTU                : 1450
# VXLAN tenant-network MTU    : 1400 (observed cs223-private-net)
# Private tenant subnet       : 10.10.10.0/24 (managed via Neutron, NOT Ansible)
# Test guest                  : cs223-test-vm, 10.10.10.117/24 on compute01
#
# หมายเหตุด้าน SSH / Ansible
# -------------------------
# - ใช้ controller01 เป็น Deployment Host และรัน Kolla Ansible ด้วย ubuntu
# - ansible_host เป็น Underlay Private IP ไม่ใช่ Floating IP ของ VM ชั้นนอก
# - ชื่อ Host ต้อง Resolve ได้ตามที่ OpenStack Services ต้องการ
#   ตรวจบนทั้งสอง Node: getent hosts controller01 compute01
# - ansible_become=true ต้องใช้ sudo ได้โดยไม่ติด Prompt ที่ทำให้ Ansible ค้าง
# - ไม่ใส่ที่อยู่ SSH Private Key ลงในตัวอย่าง Public นี้
#   ให้ใช้ SSH Agent/Key ที่ทดสอบแล้วหรือกำหนดค่าในไฟล์ส่วนตัวเท่านั้น
# - หาก Inventory จริงใช้ ansible_connection=local สำหรับ controller01
#   ต้องรักษาค่าที่ทดสอบแล้ว ไม่ควรเปลี่ยนตามตัวอย่างโดยอัตโนมัติ
#
# คำสั่งตรวจสอบ (รันบน controller01 จาก Root ของ Repo หลังเทียบกับไฟล์จริง):
#   source ~/kolla-venv/bin/activate
#   ansible-inventory -i config/multinode.example --graph
#   ansible-inventory -i config/multinode.example --host controller01
#   ansible-inventory -i config/multinode.example --host compute01
#   ansible -i config/multinode.example baremetal -m ping
#
# สำหรับระบบที่ใช้งานอยู่จริง ให้ใช้ ~/multinode เดิมที่ผ่านการ Deploy:
#   kolla-ansible prechecks -i ~/multinode   # only when a fresh check is needed
#
# เอกสารที่เกี่ยวข้อง: docs/02-architecture.md, docs/03-environment-setup.md,
#               docs/04-kolla-deployment.md, docs/07-handover.md
# =============================================================================

# =============================================================================
# 1. PRIMARY NODE ROLES: ส่วนที่ต้องแก้เมื่อเปลี่ยนจำนวน/ที่อยู่ Node
# =============================================================================

# Control Plane: API, Database, Messaging, Horizon และ Nova Scheduler
[control]
controller01 ansible_host=192.168.1.160 ansible_user=ubuntu ansible_become=true

# Network Node: Neutron L3/DHCP/Metadata และ OVS
# โปรเจกต์นี้ให้ Controller ทำหน้าที่ Network Node ด้วย (ไม่มี network01)
[network]
controller01

# Compute Node: รัน VM ผ่าน Nova Compute + libvirt/QEMU/KVM
[compute]
compute01 ansible_host=192.168.1.7 ansible_user=ubuntu ansible_become=true

# บทบาท Monitoring ไม่ได้เปิด Prometheus อัตโนมัติ
[monitoring]
controller01

# บทบาท Storage ไม่ได้เปิด Cinder อัตโนมัติ
# Lab นี้ไม่ได้เปิด Cinder ใน Configuration ปัจจุบัน
[storage]
controller01

# รัน Ansible จาก controller01 ซึ่งเป็น Deployment Host
# localhost ใน [deployment] เป็นส่วนหนึ่งของ Inventory ต้นฉบับ
[deployment]
localhost ansible_connection=local

# =============================================================================
# 2. SHARED / AGGREGATE GROUPS: รักษา Parent-Child ตามต้นฉบับ
# =============================================================================

# ชื่อ baremetal เป็นชื่อ Group ที่ Kolla ใช้ แม้ Node ของเราจะเป็น Ubuntu VMs
# ซึ่งรันอยู่บน OpenStack ชั้นนอกของมหาวิทยาลัยก็ตาม
[baremetal:children]
control
network
compute
storage
monitoring

[tls-backend:children]
control
network

# =============================================================================
# 3. KOLLA SERVICE PLACEMENT: Group Mappings มาตรฐาน stable/2026.1
# =============================================================================
# มีการประกาศ Groups ไว้แม้บาง Services จะไม่ได้เปิดใช้ใน Lab
# ห้ามลบ Group ออกเพียงเพราะไม่พบ Container ของบริการนั้น
# Services ที่ตรวจสอบใช้งานจริง ได้แก่ Keystone, Glance, Nova, Neutron,
# Horizon, Placement และ Dependencies เช่น MariaDB, RabbitMQ, Memcached
#
# Non-HA Configuration อยู่ใน globals.yml (ไม่ใช่ไฟล์ Inventory นี้):
#   enable_haproxy: false
#   enable_keepalived: false
#   enable_loadbalancer: false
#   enable_proxysql: false
# หมายเหตุ: อย่านำบรรทัด YAML เหล่านี้มาใส่เป็นค่าที่ทำงานในไฟล์ INI
# =============================================================================

